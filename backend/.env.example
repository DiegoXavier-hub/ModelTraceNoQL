APP_NAME=ModelTrace
ENVIRONMENT=development
SECRET_KEY=change-this-secret
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Leave empty to use the local JSON document store.
# Set this to MongoDB Atlas or a local MongoDB URI to use MongoDB.
MONGODB_URL=
MONGODB_DB_NAME=modeltrace
LOCAL_STORE_PATH=./backend/.data/modeltrace.json

# Reserved for future Redis-backed cache/idempotency.
REDIS_URL=

