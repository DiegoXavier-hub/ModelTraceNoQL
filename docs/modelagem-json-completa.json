{
  "database": "modeltrace",
  "version": "completa",
  "style": "document_database",
  "storage_targets": ["JSON local em backend/.data/modeltrace.json", "MongoDB"],
  "tenant_key": "org_id",
  "validated_on": "2026-05-12",
  "validated_against": [
    "backend/app/db/document_store.py",
    "backend/app/schemas.py",
    "backend/app/api/routes/*.py",
    "backend/app/services/*.py",
    "backend/.data/modeltrace.json"
  ],
  "status": "modelo atualizado para cobrir todas as colecoes declaradas no DocumentStore",
  "corrections_applied": [
    "Incluidas colecoes que faltavam na versao JSON anterior: prediction_annotations, drift_reports, webhooks, webhook_deliveries, cohorts e approvals.",
    "Predictions agora documenta model_version_id, annotations, flags e metadata.contract.",
    "Notifications usa read_at como campo canonico de leitura; nao read.",
    "Alerts agora documenta rule_id, metric, observed_value e threshold.",
    "Relacionamentos logicos foram expandidos para operacao, governanca, jobs, notificacoes, exports, webhooks e caches."
  ],
  "collections": {
    "organizations": {
      "primary_key": "_id",
      "tenant_key": null,
      "purpose": "Organizacao/tenant raiz.",
      "fields": ["_id", "name", "slug", "plan", "owner_id", "settings", "created_at", "status"],
      "embedded_documents": {
        "settings": ["max_projects", "max_predictions_per_day", "retention_days", "enable_bias_analysis", "enable_webhooks", "enable_case_management", "enable_model_governance"]
      },
      "references": {
        "owner_id": "users._id"
      }
    },
    "users": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Usuarios autenticados, perfil, preferencias, permissoes e credenciais protegidas.",
      "fields": ["_id", "org_id", "name", "email", "email_masked", "email_encrypted", "email_hash", "password_hash", "role", "job_title", "department", "company", "phone", "timezone", "bio", "avatar_url", "avatar_path", "avatar_content_type", "avatar_file_name", "avatar_updated_at", "email_verified", "email_verified_at", "project_permissions", "preferences", "created_at", "updated_at", "last_login_at", "status"],
      "embedded_documents": {
        "preferences": ["theme", "default_project", "email_alerts", "locale", "compact_mode"],
        "project_permissions": "mapa de permissoes por projeto"
      },
      "references": {
        "org_id": "organizations._id"
      }
    },
    "projects": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Caso de uso/produto de ML: dominio, configuracao operacional e contadores.",
      "fields": ["_id", "org_id", "name", "slug", "description", "i18n", "problem_type", "domain", "entity_label", "owner_id", "collaborators", "tags", "settings", "stats", "created_at", "status"],
      "embedded_documents": {
        "settings": ["default_threshold", "positive_label", "negative_label", "retention_days", "enable_drift_monitoring", "drift_check_frequency", "alert_email", "alert_email_hash", "bias_sensitive_features", "case_sla_days", "data_contract_mode"],
        "stats": ["total_predictions", "total_models", "active_alerts", "last_prediction_at"],
        "collaborators": "lista de usuarios/perfis convidados"
      },
      "references": {
        "org_id": "organizations._id",
        "owner_id": "users._id"
      }
    },
    "models": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Modelo logico com contrato de features, labels e versao de producao.",
      "fields": ["_id", "org_id", "project_id", "name", "slug", "description", "i18n", "problem_type", "target_name", "labels", "default_threshold", "primary_metric", "expected_features", "production_version_id", "created_by", "created_at", "status"],
      "embedded_documents": {
        "labels": ["positive", "negative"],
        "expected_features": ["name", "type", "required", "description", "range", "allowed_values"]
      },
      "references": {
        "org_id": "organizations._id",
        "project_id": "projects._id",
        "production_version_id": "model_versions._id",
        "created_by": "users._id"
      }
    },
    "model_versions": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Versao treinada/promovida do modelo, com algoritmo, features e metricas offline.",
      "fields": ["_id", "org_id", "project_id", "model_id", "version", "algorithm", "status", "created_by", "created_at", "promoted_to_production_at", "deprecated_at", "features", "hyperparameters", "training_metadata", "offline_metrics", "changelog", "notes"],
      "embedded_documents": {
        "features": "lista de nomes de features usadas pela versao",
        "hyperparameters": "mapa livre por algoritmo",
        "training_metadata": "dataset, janela, splits, artefatos e contexto de treino",
        "offline_metrics": "mapa de metricas calculadas fora de producao"
      },
      "references": {
        "org_id": "organizations._id",
        "project_id": "projects._id",
        "model_id": "models._id",
        "created_by": "users._id"
      },
      "logical_constraints": [
        "model_id + version deve ser unico; hoje a API valida antes de inserir."
      ]
    },
    "api_keys": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Chaves de API por projeto, persistidas apenas como hash.",
      "fields": ["_id", "org_id", "project_id", "name", "prefix", "key_hash", "hash_algorithm", "scopes", "expires_at", "created_by", "created_at", "last_used_at", "revoked_at", "status"],
      "references": {
        "org_id": "organizations._id",
        "project_id": "projects._id",
        "created_by": "users._id"
      }
    },
    "email_tokens": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Tokens de verificacao de email e reset de senha, armazenados por hash.",
      "fields": ["_id", "org_id", "user_id", "purpose", "token_hash", "created_at", "expires_at", "used_at", "status"],
      "references": {
        "org_id": "organizations._id",
        "user_id": "users._id"
      }
    },
    "notifications": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Mensagens internas geradas por alertas, jobs, seguranca e eventos do sistema.",
      "fields": ["_id", "org_id", "user_id", "project_id", "type", "title", "message", "severity", "i18n", "link", "links", "metadata", "read_at", "created_at"],
      "references": {
        "org_id": "organizations._id",
        "user_id": "users._id",
        "project_id": "projects._id"
      }
    },
    "jobs": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Execucoes assincronas para alertas, drift, metricas, diagnosticos e dashboard.",
      "fields": ["_id", "org_id", "project_id", "model_id", "type", "params", "status", "created_by", "created_at", "started_at", "finished_at", "progress", "result", "error"],
      "references": {
        "org_id": "organizations._id",
        "project_id": "projects._id",
        "model_id": "models._id",
        "created_by": "users._id"
      }
    },
    "saved_views": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Filtros, colunas e ordenacao salvos por usuario/tela.",
      "fields": ["_id", "org_id", "user_id", "project_id", "view", "name", "filters", "columns", "sort", "shared", "created_at", "updated_at"],
      "references": {
        "org_id": "organizations._id",
        "user_id": "users._id",
        "project_id": "projects._id"
      }
    },
    "entity_notes": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Notas operacionais por entidade, fora do documento de predicao.",
      "fields": ["_id", "org_id", "project_id", "entity_hash", "entity_id", "entity_display", "content", "body", "tags", "created_by", "created_at"],
      "references": {
        "org_id": "organizations._id",
        "project_id": "projects._id",
        "created_by": "users._id"
      }
    },
    "prediction_scenarios": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Historico persistido de cenarios what-if quando for necessario guardar simulacoes.",
      "fields": ["_id", "org_id", "project_id", "prediction_id", "name", "mode", "feature_overrides", "result", "created_by", "created_at"],
      "references": {
        "org_id": "organizations._id",
        "project_id": "projects._id",
        "prediction_id": "predictions._id",
        "created_by": "users._id"
      }
    },
    "predictions": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Colecao central. Cada documento representa uma decisao de ML completa, com payload variavel por modelo.",
      "fields": ["_id", "org_id", "project_id", "model_id", "model_version_id", "model_version", "entity", "created_at", "features", "prediction", "explanations", "decision", "feedback", "annotations", "flags", "metadata"],
      "embedded_documents": {
        "entity": ["id", "id_hash", "id_encrypted", "id_masked", "type", "display_name", "display_name_encrypted", "display_name_masked", "cohort"],
        "features": "mapa livre por modelo; ex.: student, company, asset ou generic",
        "prediction": ["label", "score", "threshold", "above_threshold", "score_band"],
        "explanations": ["feature", "value", "impact", "direction", "rank"],
        "decision": ["action", "status", "reason", "triggered_at", "assignee"],
        "feedback": ["available", "observed_label", "observed_value", "classification_result", "received_at", "feedback_date", "source", "notes"],
        "annotations": "lista legada embutida; anotacoes novas ficam em prediction_annotations",
        "flags": ["is_critical", "reviewed_by", "reviewed_at", "contract_status"],
        "metadata": ["source_system", "environment", "request_id", "latency_ms", "payload_version", "window", "algorithm", "contract", "methodological_warning"]
      },
      "references": {
        "org_id": "organizations._id",
        "project_id": "projects._id",
        "model_id": "models._id",
        "model_version_id": "model_versions._id"
      },
      "embed_vs_reference": {
        "embedded": ["entity", "features", "prediction", "explanations", "decision", "feedback", "flags", "metadata"],
        "referenced": ["prediction_annotations", "prediction_replays", "prediction_scenarios", "intervention_cases", "audit_events"]
      }
    },
    "prediction_annotations": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Comentarios, flags e anotacoes de analistas sobre uma predicao.",
      "fields": ["_id", "org_id", "project_id", "prediction_id", "user_id", "type", "content", "tags", "created_at"],
      "references": {
        "prediction_id": "predictions._id",
        "project_id": "projects._id",
        "user_id": "users._id"
      }
    },
    "prediction_replays": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Resultado de reprocessar uma decisao em outra versao ou com features hipoteticas.",
      "fields": ["_id", "org_id", "project_id", "prediction_id", "model_id", "original", "replay", "hypothetical_features", "estimation", "decision_changed", "created_by", "created_at"],
      "embedded_documents": {
        "original": ["model_version", "score", "label", "above_threshold"],
        "replay": ["target_version", "score", "label", "above_threshold"]
      },
      "references": {
        "prediction_id": "predictions._id",
        "project_id": "projects._id",
        "model_id": "models._id",
        "created_by": "users._id"
      }
    },
    "metrics_snapshots": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Metricas agregadas por dia/modelo/versao para dashboard e comparacoes.",
      "fields": ["_id", "org_id", "project_id", "model_id", "model_version", "period", "counts", "performance", "confusion_matrix", "score_distribution", "computed_at"],
      "embedded_documents": {
        "period": ["granularity", "start", "end", "label"],
        "counts": ["total", "positive", "negative", "with_feedback", "without_feedback"],
        "performance": ["accuracy", "precision", "recall", "f1"],
        "confusion_matrix": ["tp", "fp", "tn", "fn"],
        "score_distribution": ["mean", "std", "histogram"]
      },
      "references": {
        "project_id": "projects._id",
        "model_id": "models._id"
      }
    },
    "dashboard_cache": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Resposta materializada do dashboard por projeto.",
      "fields": ["_id", "org_id", "project_id", "cache_version", "prediction_count", "alert_count", "dashboard", "computed_at"],
      "references": {
        "project_id": "projects._id"
      }
    },
    "diagnostic_cache": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Diagnosticos materializados do DS Lab: threshold, calibracao, cobertura, slices e erros.",
      "fields": ["_id", "org_id", "project_id", "model_id", "slice_feature", "cache_version", "prediction_count", "feedback_count", "diagnostics", "computed_at"],
      "references": {
        "project_id": "projects._id",
        "model_id": "models._id"
      }
    },
    "drift_reports": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Relatorios de drift de score e features por modelo.",
      "fields": ["_id", "org_id", "project_id", "model_id", "model_version", "status", "message", "reference_period", "current_period", "prediction_drift", "data_drift", "created_at"],
      "embedded_documents": {
        "reference_period": ["start", "end", "count"],
        "current_period": ["start", "end", "count"],
        "prediction_drift": ["psi", "mean_score_ref", "mean_score_cur", "status"],
        "data_drift": ["features"]
      },
      "references": {
        "project_id": "projects._id",
        "model_id": "models._id"
      }
    },
    "alert_rules": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Regras configuraveis para gerar alertas.",
      "fields": ["_id", "org_id", "project_id", "model_id", "name", "i18n", "type", "metric", "operator", "threshold", "severity", "min_feedback_count", "enabled", "created_by", "created_at", "updated_at"],
      "references": {
        "project_id": "projects._id",
        "model_id": "models._id",
        "created_by": "users._id"
      }
    },
    "alerts": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Ocorrencias abertas/acknowledged/resolvidas geradas por regras.",
      "fields": ["_id", "org_id", "project_id", "model_id", "rule_id", "title", "type", "severity", "status", "message", "i18n", "metric", "observed_value", "threshold", "target", "created_at", "acknowledged_by", "acknowledged_at", "resolved_by", "resolved_at"],
      "references": {
        "project_id": "projects._id",
        "model_id": "models._id",
        "rule_id": "alert_rules._id",
        "acknowledged_by": "users._id",
        "resolved_by": "users._id"
      }
    },
    "webhooks": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Endpoints externos para eventos de projeto/organizacao. Colecao preparada no store.",
      "fields": ["_id", "org_id", "project_id", "name", "url", "secret_hash", "events", "status", "created_by", "created_at", "updated_at"],
      "references": {
        "org_id": "organizations._id",
        "project_id": "projects._id",
        "created_by": "users._id"
      }
    },
    "webhook_deliveries": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Tentativas de entrega de webhook e resultado HTTP.",
      "fields": ["_id", "org_id", "project_id", "webhook_id", "event_type", "resource", "payload", "status", "attempts", "last_status_code", "last_error", "created_at", "delivered_at"],
      "references": {
        "webhook_id": "webhooks._id",
        "project_id": "projects._id"
      }
    },
    "datasets": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Bases importadas, matrizes de features, fontes e perfis de dados.",
      "fields": ["_id", "org_id", "project_id", "name", "type", "source_type", "source_uri", "source_files", "schema", "profile", "row_count", "student_count", "entity_count", "created_at"],
      "references": {
        "project_id": "projects._id"
      }
    },
    "cohorts": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Segmentos/coortes operacionais por filtros e tamanho.",
      "fields": ["_id", "org_id", "project_id", "name", "type", "filters", "size", "open_cases", "created_at"],
      "references": {
        "project_id": "projects._id"
      }
    },
    "model_evaluations": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Avaliacoes offline/online por modelo e versao, usadas em Operacao e comparacao.",
      "fields": ["_id", "org_id", "project_id", "model_id", "model_version_id", "algorithm", "window", "rank", "offline_test_metrics", "production_simulation", "business_fit", "evaluation_caveat", "created_at"],
      "references": {
        "project_id": "projects._id",
        "model_id": "models._id",
        "model_version_id": "model_versions._id"
      }
    },
    "model_cards": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Documentacao de governanca do modelo.",
      "fields": ["_id", "org_id", "project_id", "model_id", "version", "title", "intended_use", "not_for_use", "training_context", "known_limitations", "ethical_considerations", "governance", "approval", "created_at"],
      "references": {
        "project_id": "projects._id",
        "model_id": "models._id"
      }
    },
    "intervention_cases": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Casos operacionais gerados a partir de predicoes acionaveis.",
      "fields": ["_id", "org_id", "project_id", "model_id", "prediction_id", "entity_id", "entity_display_name", "student_id", "student_display_name", "status", "priority", "priority_rank", "risk_score", "risk_band", "window_used", "recommended_action", "owner_team", "sla_due_at", "outcome_status", "drivers", "timeline", "created_at", "updated_at", "closed_at"],
      "embedded_documents": {
        "drivers": "principais fatores da decisao",
        "timeline": ["status", "note", "actor", "created_at"]
      },
      "references": {
        "project_id": "projects._id",
        "model_id": "models._id",
        "prediction_id": "predictions._id"
      }
    },
    "incidents": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Incidentes operacionais ou de modelo.",
      "fields": ["_id", "org_id", "project_id", "severity", "status", "title", "impact", "root_cause", "created_by", "created_at", "resolved_at"],
      "references": {
        "project_id": "projects._id",
        "created_by": "users._id"
      }
    },
    "data_quality_reports": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Perfil e controles de qualidade para datasets importados.",
      "fields": ["_id", "org_id", "project_id", "dataset_id", "created_at", "source", "checks", "status_counts", "eligibility", "missingness", "pii_fields_detected", "controls", "warnings"],
      "references": {
        "project_id": "projects._id",
        "dataset_id": "datasets._id"
      }
    },
    "approvals": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Aprovacoes de governanca, releases ou uso de modelo.",
      "fields": ["_id", "org_id", "project_id", "model_id", "model_version_id", "title", "status", "requested_by", "approved_by", "created_at", "approved_at", "notes"],
      "references": {
        "project_id": "projects._id",
        "model_id": "models._id",
        "model_version_id": "model_versions._id",
        "requested_by": "users._id",
        "approved_by": "users._id"
      }
    },
    "audit_events": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Eventos imutaveis para auditoria e evidencias.",
      "fields": ["_id", "org_id", "project_id", "actor", "event_type", "resource", "context", "diff", "created_at"],
      "embedded_documents": {
        "actor": ["type", "id", "email_masked", "email_hash", "api_key_id"],
        "resource": ["type", "id"],
        "diff": ["before", "after"]
      },
      "references": {
        "org_id": "organizations._id",
        "project_id": "projects._id"
      }
    },
    "exports": {
      "primary_key": "_id",
      "tenant_key": "org_id",
      "purpose": "Arquivos de exportacao e evidencias geradas pela interface/API.",
      "fields": ["_id", "org_id", "project_id", "type", "filters", "format", "include_features", "include_explanations", "redact_pii", "status", "file_path", "record_count", "created_by", "created_at"],
      "references": {
        "project_id": "projects._id",
        "created_by": "users._id"
      },
      "visibility_note": "file_path e interno e nao deve ser retornado nas respostas publicas."
    }
  },
  "relationship_summary": [
    { "from": "organizations", "to": "users", "type": "1:N", "key": "org_id" },
    { "from": "organizations", "to": "projects", "type": "1:N", "key": "org_id" },
    { "from": "organizations", "to": "api_keys", "type": "1:N", "key": "org_id" },
    { "from": "organizations", "to": "notifications", "type": "1:N", "key": "org_id" },
    { "from": "organizations", "to": "jobs", "type": "1:N", "key": "org_id" },
    { "from": "organizations", "to": "audit_events", "type": "1:N", "key": "org_id" },
    { "from": "users", "to": "email_tokens", "type": "1:N", "key": "user_id" },
    { "from": "users", "to": "saved_views", "type": "1:N", "key": "user_id" },
    { "from": "users", "to": "entity_notes", "type": "1:N", "key": "created_by" },
    { "from": "projects", "to": "models", "type": "1:N", "key": "project_id" },
    { "from": "projects", "to": "api_keys", "type": "1:N", "key": "project_id" },
    { "from": "projects", "to": "predictions", "type": "1:N", "key": "project_id" },
    { "from": "projects", "to": "metrics_snapshots", "type": "1:N", "key": "project_id" },
    { "from": "projects", "to": "dashboard_cache", "type": "1:0..1", "key": "project_id" },
    { "from": "projects", "to": "datasets", "type": "1:N", "key": "project_id" },
    { "from": "projects", "to": "cohorts", "type": "1:N", "key": "project_id" },
